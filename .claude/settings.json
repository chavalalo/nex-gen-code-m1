{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.venv/**)",
      "Read(./**/__pycache__/**)",
      "Read(./.pytest_cache/**)",
      "Read(./.ruff_cache/**)",
      "Edit(./tests/test_almacen.py)",
      "Edit(./tests/test_gestor.py)",
      "Edit(./tests/test_reportes.py)",
      "Edit(./tests/conftest.py)",
      "Edit(./pyproject.toml)"
    ],
    "allow": [
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ruff check:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python -m pytest -q -x >&2 || exit 2"
          }
        ]
      }
    ]
  }
}
